# Keep the working tree LF on every platform.
#
# core.autocrlf=true was checking these files out as CRLF while tools/ generates
# them with LF, so `node tools/build_pages.js --check` reported every generated
# page stale immediately after a clone or a branch switch, and running the build
# produced a whole-file diff that hid the real change. Pinning eol=lf makes the
# checked-out bytes and the generated bytes agree.

* text=auto eol=lf

# Binary — never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.zip  binary
